# PostgreSQL bağlantısı (Vercel'de Neon/Supabase). Boş bırakılırsa yerelde gömülü Postgres (PGlite) kullanılır.
DATABASE_URL=

# Panel parolası (HTTP Basic Auth). Canlıda mutlaka tanımlayın.
PANEL_USER=admin
PANEL_PASSWORD=

# 1 ise boş veritabanına ilk kurulumda örnek veri yüklenir (npm run db:migrate sırasında).
SEED_DEMO=

# Yerel geliştirmede ağ kapalıysa örnek hava durumu kullanır.
WEATHER_FIXTURE=
